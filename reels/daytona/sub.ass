Dialogue: 0,0:00:00.42,0:00:01.26,D,,0,0,0,,눈 뜨자마자
Dialogue: 0,0:00:01.26,0:00:02.04,D,,0,0,0,,창밖이 {\c&H0080FF&}바다{\c&HFFFFFF&}로
Dialogue: 0,0:00:02.04,0:00:03.11,D,,0,0,0,,꽉 차요
Dialogue: 0,0:00:03.16,0:00:03.84,D,,0,0,0,,{\c&H0080FF&}포항{\c&HFFFFFF&} 바닷가
Dialogue: 0,0:00:03.84,0:00:04.89,D,,0,0,0,,앞 {\c&H0080FF&}풀빌라{\c&HFFFFFF&}인데
Dialogue: 0,0:00:04.94,0:00:05.92,D,,0,0,0,,객실마다 {\c&H0080FF&}통창{\c&HFFFFFF&}이
Dialogue: 0,0:00:05.92,0:00:06.24,D,,0,0,0,,벽 한
Dialogue: 0,0:00:06.24,0:00:07.21,D,,0,0,0,,면이에요
Dialogue: 0,0:00:07.26,0:00:07.66,D,,0,0,0,,해 뜨는
Dialogue: 0,0:00:07.66,0:00:08.42,D,,0,0,0,,시간엔 거실에
Dialogue: 0,0:00:08.42,0:00:09.08,D,,0,0,0,,앉아서 동해
Dialogue: 0,0:00:09.08,0:00:09.79,D,,0,0,0,,{\c&H0080FF&}일출{\c&HFFFFFF&} 보고
Dialogue: 0,0:00:09.84,0:00:10.44,D,,0,0,0,,창가 따라
Dialogue: 0,0:00:10.44,0:00:11.10,D,,0,0,0,,{\c&H0080FF&}수영장{\c&HFFFFFF&}이 있는
Dialogue: 0,0:00:11.10,0:00:12.25,D,,0,0,0,,객실도 있어요
Dialogue: 0,0:00:12.30,0:00:13.30,D,,0,0,0,,{\c&H0080FF&}침대{\c&HFFFFFF&}에 누워도
Dialogue: 0,0:00:13.30,0:00:14.61,D,,0,0,0,,바다가 한가득이고
Dialogue: 0,0:00:14.66,0:00:15.66,D,,0,0,0,,해변까지 걸어서
Dialogue: 0,0:00:15.66,0:00:16.23,D,,0,0,0,,{\c&H0080FF&}5분{\c&HFFFFFF&}이라
Dialogue: 0,0:00:16.29,0:00:16.95,D,,0,0,0,,{\c&H0080FF&}알람 없이{\c&HFFFFFF&}
Dialogue: 0,0:00:16.95,0:00:17.46,D,,0,0,0,,바다 보고
Dialogue: 0,0:00:17.46,0:00:19.20,D,,0,0,0,,일어나는 곳이에요
